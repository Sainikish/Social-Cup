# Copy this file to .env.local (gitignored) and fill in real values.
# See mobile/README.md "Environment configuration" for full details.

# One of: development | staging | production
# Omit entirely (or set to "development") for local work - it's the default.
EXPO_PUBLIC_APP_ENV=development

# Full backend base URL INCLUDING the /api context path.
# Leave unset for local development against the Android emulator or iOS
# simulator - src/config/env.ts fills in a sensible localhost default for
# each. A physical device on the same network MUST set this explicitly to
# your computer's LAN IP, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.23:8080/api
# staging/production builds MUST also set this explicitly - there is no
# built-in fallback for those environments.
EXPO_PUBLIC_API_URL=

# Stripe PUBLISHABLE key only (safe for client-side use - never the secret
# key). Used solely to create a PaymentMethod on-device via
# @stripe/stripe-react-native; the resulting PaymentMethod id is sent to the
# backend, which owns all Stripe secret-key operations.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
