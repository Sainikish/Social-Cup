# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/socialcup
DATABASE_USER=socialcup
DATABASE_PASSWORD=socialcup

# JWT Configuration
JWT_SECRET=your-secret-key-here-minimum-32-characters

# Stripe Configuration
STRIPE_API_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# AWS Configuration (SES transactional email only - cafe/drink photos are
# stored in this same Postgres database instead of S3, see PhotoStorageService)
AWS_REGION=us-east-1
AWS_SES_SENDER=noreply@socialcup.app

# The externally-reachable URL this backend is served at, including the
# /api context path - used to build photo URLs (see PhotoController).
PUBLIC_BASE_URL=https://social-cup-production.up.railway.app/api

# Sentry Configuration
SENTRY_ENABLED=false
SENTRY_DSN=https://your-sentry-dsn
SENTRY_ENVIRONMENT=development

# Google OAuth2
GOOGLE_OAUTH_CLIENT_ID=your_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret

# Apple Sign-In
APPLE_OAUTH_TEAM_ID=your_team_id
APPLE_OAUTH_KEY_ID=your_key_id
APPLE_OAUTH_PRIVATE_KEY=your_private_key_path

# Application
SPRING_PROFILES_ACTIVE=dev
