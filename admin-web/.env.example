# Base URL of the Social Cup backend API, including the /api context path.
# Example (local development): http://localhost:8080/api
# Required outside local development - the app fails fast at startup if this
# is missing and no local-dev fallback applies (see src/config/env.ts).
VITE_API_BASE_URL=

# Origin of the deployed barista-web app, no trailing slash. Used only to
# build the barista scan/login link shown on a cafe's Barista Access section
# (CafeDetail) - required outside local development, same fail-fast rule as
# VITE_API_BASE_URL above (see src/config/env.ts).
VITE_BARISTA_WEB_URL=
